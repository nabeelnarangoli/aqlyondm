{# Decorative animation for service tile number `i` (0–6). #}
{% if i == 0 %}
<svg viewBox="0 0 300 300" aria-hidden="true" style="position:absolute;right:-40px;top:60px;width:340px;height:340px">
<circle class="draw" cx="140" cy="140" r="78" fill="none" stroke="#0B0B0B" stroke-width="26" stroke-linecap="round" style="--len:490;stroke-dasharray:490"/>
<line class="draw" x1="196" y1="196" x2="240" y2="240" stroke="#0B0B0B" stroke-width="26" stroke-linecap="round" style="--len:62;stroke-dasharray:62;animation-delay:.5s"/>
</svg>
{% elif i == 1 %}
<span aria-hidden="true" style="position:absolute;left:50%;top:96px;margin-left:-60px;width:120px;height:0"><span class="bounce" style="position:absolute;left:10px;top:-30px;width:30px;height:30px;border-radius:50%;background:#FFB547"></span><span class="spin-mid" style="position:absolute;left:70px;top:-30px;width:30px;height:30px;border-radius:6px;background:#22AD72"></span></span>
<span aria-hidden="true" style="position:absolute;left:24px;right:24px;top:124px;height:4px;border-radius:2px;background:#333"><span class="playhead" style="position:absolute;top:-5px;width:3px;height:14px;background:#fff"></span></span>
{% elif i == 2 %}
<span aria-hidden="true" style="position:absolute;right:40px;top:40px;width:70px;height:70px"><span class="ping" style="position:absolute;inset:0;border-radius:50%;border:2px solid #0B0B0B"></span><span class="ping" style="position:absolute;inset:0;border-radius:50%;border:2px solid #0B0B0B;animation-delay:1.3s"></span><span style="position:absolute;inset:20px;border-radius:50%;background:#0B0B0B"></span></span>
{% elif i == 3 %}
<span aria-hidden="true" style="position:absolute;left:50%;top:100px;width:0;height:0"><span class="deck" style="position:absolute;left:-32px;top:-66px;width:64px;height:110px;border-radius:12px;background:#0B0B0B"></span><span class="deck" style="position:absolute;left:-50px;top:-50px;width:100px;height:100px;border-radius:12px;background:#fff;animation-delay:1.8s;opacity:0"></span><span class="deck" style="position:absolute;left:-64px;top:-40px;width:128px;height:80px;border-radius:12px;background:#22AD72;animation-delay:3.6s;opacity:0"></span></span>
{% elif i == 4 %}
<svg viewBox="0 0 220 120" aria-hidden="true" style="position:absolute;left:20px;top:40px;width:calc(100% - 40px)"><path class="draw" d="M10 100 C 50 10, 110 10, 130 60 S 190 120, 210 20" fill="none" stroke="#0B0B0B" stroke-width="5" stroke-linecap="round" style="--len:330;stroke-dasharray:330"/><rect class="pop" x="4" y="94" width="12" height="12" fill="#fff" stroke="#0B0B0B" stroke-width="2"/><rect class="pop" x="204" y="14" width="12" height="12" fill="#fff" stroke="#0B0B0B" stroke-width="2" style="animation-delay:1s"/></svg>
{% elif i == 5 %}
<svg viewBox="0 0 260 260" aria-hidden="true" style="position:absolute;right:24px;top:24px;width:130px;height:130px"><circle cx="130" cy="130" r="124" fill="#0B0B0B"/><g class="iris"><path d="M130 130 L130 30 A100 100 0 0 1 216.6 80 Z" fill="#8FD3FF"/><path d="M130 130 L216.6 80 A100 100 0 0 1 216.6 180 Z" fill="#5BB6EE"/><path d="M130 130 L216.6 180 A100 100 0 0 1 130 230 Z" fill="#8FD3FF"/><path d="M130 130 L130 230 A100 100 0 0 1 43.4 180 Z" fill="#5BB6EE"/><path d="M130 130 L43.4 180 A100 100 0 0 1 43.4 80 Z" fill="#8FD3FF"/><path d="M130 130 L43.4 80 A100 100 0 0 1 130 30 Z" fill="#5BB6EE"/></g></svg>
{% else %}
<span aria-hidden="true" style="position:absolute;right:30px;top:30px;height:110px;display:flex;align-items:flex-end;gap:8px"><span class="bar" style="width:20px;height:100%;border-radius:6px;background:#D8F5E5"></span><span class="bar" style="width:20px;height:100%;border-radius:6px;background:#9EE8BF;animation-delay:.2s"></span><span class="bar" style="width:20px;height:100%;border-radius:6px;background:#5CD691;animation-delay:.4s"></span><span class="bar" style="width:20px;height:100%;border-radius:6px;background:#22AD72;animation-delay:.6s"></span></span>
{% endif %}
