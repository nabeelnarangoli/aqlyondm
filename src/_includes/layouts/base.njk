<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if seo_title %}{% set pageTitle = seo_title %}{% elif page.url == "/" %}{% set pageTitle = site.seo_home_title or (site.title + " | " + site.description) %}{% elif title %}{% set pageTitle = title + " | " + site.title %}{% else %}{% set pageTitle = site.title %}{% endif %}
{% set pageDesc = meta_description or description or excerpt or (site.seo_home_description if page.url == "/" else "") or site.description %}
{% set pageUrl = page.url | absoluteUrl(site.url) %}
{% set pageImage = (cover or '/img/og-default.png') | absoluteUrl(site.url) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
{% set focusKw = focus_keyword or (site.seo_home_keyword if page.url == "/" else "") %}{% if focusKw %}<meta name="seo:focus" content="{{ focusKw }}">{% endif %}
{% if site.google_verification %}<meta name="google-site-verification" content="{{ site.google_verification }}">{% endif %}
<link rel="canonical" href="{{ pageUrl }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ pageImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0B0B0B">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/assets/css/site.css?v={{ build.v }}">
{% if eventsModule %}<link rel="stylesheet" href="/site/events.css?v={{ build.v }}">{% endif %}
{% include "partials/schema.njk" %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/js/site.js?v={{ build.v }}" defer></script>
{% if eventsModule %}<script src="/site/events.js?v={{ build.v }}" defer></script>{% endif %}
</body>
</html>
